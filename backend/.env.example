# Backend — local copy: backend/.env
# Render: set these in the Web Service → Environment tab

# --- Cloud / CORS ---
# Comma-separated origins, no trailing slash. Code also allows https://*.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://blur-face.vercel.app

# true on Render: block server-side cv2 webcam (browser uses /ws/process instead)
DISABLE_SERVER_WEBCAM=false

# --- Capture sizing (browser / RTSP processing target) ---
CAMERA_DEVICE_ID=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# --- RTSP ---
RTSP_RECONNECT_INTERVAL=3.0
RTSP_OPEN_TIMEOUT=8.0

# --- WebRTC (optional; production prefers JPEG WS) ---
WEBRTC_TARGET_FPS=15
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# --- Detection (shared SCRFD) ---
DET_MODEL_NAME=det_10g
DET_INPUT_SIZE=[640,640]
DET_CONF_THRESHOLD=0.3
DET_NMS_THRESHOLD=0.4
FACE_HOLD_SEC=1.0

# --- Blur ---
BLUR_METHOD=gaussian
BLUR_KERNEL_SIZE=51
BLUR_SIGMA=30.0
BLUR_PIXELATION_BLOCK=16
BLUR_MARGIN=0.12

# --- WebSocket / performance ---
WS_MAX_QUEUE_SIZE=5
WS_METRICS_INTERVAL=10
JPEG_QUALITY=75
