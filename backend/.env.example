# Camera (webcam defaults)
CAMERA_DEVICE_ID=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# RTSP
RTSP_RECONNECT_INTERVAL=3.0
RTSP_OPEN_TIMEOUT=8.0

# WebRTC
WEBRTC_TARGET_FPS=25
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# CORS (add your Vercel frontend URL, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Detection
DET_MODEL_NAME=det_10g
DET_INPUT_SIZE=[640,640]
DET_CONF_THRESHOLD=0.5
DET_NMS_THRESHOLD=0.4

# Blur
BLUR_METHOD=gaussian
BLUR_KERNEL_SIZE=51
BLUR_SIGMA=30.0
BLUR_PIXELATION_BLOCK=16
BLUR_MARGIN=0.2

# WebSocket
WS_MAX_QUEUE_SIZE=5
WS_METRICS_INTERVAL=10

# Performance
JPEG_QUALITY=80
