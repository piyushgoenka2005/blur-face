# Frontend (Vite) — copy to .env.local for local overrides
# On Vercel: Project Settings → Environment Variables

# Public backend URL (required for production / Vercel deploy)
# Example: https://blur-face-api.onrender.com
VITE_BACKEND_URL=http://127.0.0.1:8001

# Stream mode: jpeg (cloud-safe) | webrtc (local LAN)
# Leave unset to auto-pick jpeg for remote backends.
# VITE_STREAM_MODE=jpeg
