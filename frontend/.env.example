# Frontend (Vite) — copy to .env.local for local overrides
# On Vercel: Project Settings → Environment Variables → Redeploy

# Required in production (no trailing slash)
# Example: https://blur-face-api.onrender.com
VITE_BACKEND_URL=http://127.0.0.1:8001

# jpeg = cloud-safe WebSocket stream (use on Vercel → Render)
# webrtc = local LAN only
VITE_STREAM_MODE=jpeg
